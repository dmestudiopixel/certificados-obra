# Copiá este archivo como .env para desarrollo local.
# En Railway estas variables se cargan en la pestaña Variables.

DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
JWT_SECRET=poner-aca-una-frase-larga-y-secreta
NODE_ENV=production

# Claves iniciales (solo se usan la PRIMERA vez, con la base vacía)
ADMIN_PASS=cambiar-esta-clave
CARGA_PASS=cambiar-esta-clave
VEEDOR_PASS=cambiar-esta-clave
